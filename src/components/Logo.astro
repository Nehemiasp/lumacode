---
// El logo se usa siempre como archivo SVG, nunca reescrito con la fuente.
// Dos imágenes con clases por tema (ver global.css); sin filtros CSS.
interface Props {
  /** Alto en píxeles. */
  height?: number;
  /** Solo el símbolo (cuadrado). */
  symbol?: boolean;
  priority?: boolean;
}
const { height = 28, symbol = false, priority = false } = Astro.props;
const kind = symbol ? 'symbol' : 'lockup';
const width = symbol ? height : Math.round((height * 11714) / 1849);
const style = `height:${height}px;width:auto`;
---

<img class="logo-ink" src={`/brand/svg/lumacode-${kind}-ink.svg`} alt="Lumacode" width={width} height={height} style={style} decoding="async" fetchpriority={priority ? 'high' : undefined} />
<img class="logo-paper" src={`/brand/svg/lumacode-${kind}-paper.svg`} alt="Lumacode" width={width} height={height} style={style} decoding="async" loading="lazy" />
