---
import { config } from '../config';
import { channels } from '../lib/channels';
import { route, useT, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
const social = channels();
---

<section class="section section--line" id="contacto" aria-labelledby="contacto-titulo">
  <div class="container contact">
    <h2 class="display-xl" id="contacto-titulo">
      {t('contact.title.1')}<br />
      {t('contact.title.2')}
    </h2>
    <a class="heading-1 accent-text contact__mail" href={`mailto:${config.email}`}>{config.email}</a>
    <div class="contact__actions">
      <a class="btn" href={route('contact', lang)}>{t('contact.cta')}</a>
      {social.length > 0 && (
        <ul class="contact__social">
          {social.map((c) => (
            <li>
              <a class="label link" href={c.href} target="_blank" rel="noopener">{c.label}<span class="sr-only"> {t('ui.external')}</span></a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .contact { display: grid; gap: var(--space-4); justify-items: start; }
  .contact__mail { font-size: clamp(22px, 7.2vw, 44px); overflow-wrap: anywhere; text-underline-offset: 6px; }
  .contact__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-5); margin-top: var(--space-2); }
  .contact__social { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-4); }
</style>
