---
interface Props {
  name: string;
  forWho: string;
  includes: string;
  price: string;
  /** El paquete destacado va en .section-ink con la luz junto al nombre. */
  featured?: boolean;
}
const { name, forWho, includes, price, featured = false } = Astro.props;
---

<article class:list={['pkg', { 'section-ink': featured, 'pkg--featured': featured }]}>
  <header class="pkg__head">
    <h3 class="heading-2">{name}</h3>
    {featured && <span class="pkg__light" aria-hidden="true"></span>}
  </header>
  <p class="label graphite">{forWho}</p>
  <p class="body pkg__includes">{includes}</p>
  <p class="pkg__price">{price}</p>
</article>

<style>
  .pkg {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-height: 320px;
    padding: 28px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-0);
  }
  .pkg__head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
  .pkg__light { flex: none; width: 20px; height: 20px; border-radius: var(--radius-full); background: var(--luma); }
  .pkg__includes { flex: 1; }
  .pkg__price {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 26px;
    line-height: 1.2;
    font-weight: 700;
  }
</style>
