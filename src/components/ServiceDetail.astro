---
interface Props {
  name: string;
  description: string;
  deliverablesTitle: string;
  deliverables: string[];
  ideal: string;
}
const { name, description, deliverablesTitle, deliverables, ideal } = Astro.props;
---

<article class="detail">
  <h2 class="heading-2">{name}</h2>
  <p class="body">{description}</p>
  <div class="detail__side">
    <h3 class="label graphite">{deliverablesTitle}</h3>
    <ul class="body detail__list">
      {deliverables.map((item) => <li>{item}</li>)}
    </ul>
    <p class="label graphite">{ideal}</p>
  </div>
</article>

<style>
  .detail { display: grid; gap: var(--space-3); padding-block: var(--space-5); border-top: 1px solid var(--line); }
  .detail:last-child { border-bottom: 1px solid var(--line); }
  .detail__side { display: grid; gap: var(--space-3); align-content: start; }
  .detail__list { list-style: disc; padding-left: var(--space-4); }
  .detail__list li { padding-block: 2px; }
  @media (min-width: 768px) {
    .detail { grid-template-columns: 4fr 4fr 4fr; gap: var(--space-4); }
  }
</style>
