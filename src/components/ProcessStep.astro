---
interface Props {
  title: string;
  description: string;
  /** El último paso lleva la luz. */
  last?: boolean;
}
const { title, description, last = false } = Astro.props;
---

<li class:list={['step', { 'step--last': last }]}>
  <h3 class="heading-3">{title}</h3>
  <p class="body graphite">{description}</p>
</li>

<style>
  .step { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-3); border-top: 2px solid var(--ink); }
  .step--last { border-top-color: var(--luma); }
</style>
