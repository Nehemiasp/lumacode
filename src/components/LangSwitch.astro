---
import { useT, type Lang } from '../i18n';
interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const { t } = useT(lang);
const items: { code: Lang; label: string }[] = [
  { code: 'es', label: 'ES' },
  { code: 'en', label: 'EN' },
];
---

<nav class="lang" aria-label={t('nav.language')}>
  {items.map(({ code, label }, i) => (
    <>
      {i > 0 && <span class="lang__sep" aria-hidden="true">/</span>}
      <a href={alternates[code]} lang={code} hreflang={code} aria-current={code === lang ? 'true' : undefined} class:list={['lang__link', 'label', { 'is-current': code === lang }]}>{label}</a>
    </>
  ))}
</nav>

<style>
  .lang { display: inline-flex; align-items: center; gap: var(--space-1); }
  .lang__sep { color: var(--graphite); }
  .lang__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--space-2);
    color: var(--graphite);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .lang__link:hover { color: var(--luma-text); }
  .lang__link.is-current { color: var(--ink); }
</style>
