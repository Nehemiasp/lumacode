---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { caseUrl, useT, type Lang } from '../i18n';
import { serviceName } from '../lib/services';

interface Props {
  project: CollectionEntry<'proyectos'>;
  lang: Lang;
  /** La primera imagen visible no se carga en diferido. */
  eager?: boolean;
}
const { project, lang, eager = false } = Astro.props;
const { t } = useT(lang);
const d = project.data;
---

<a class="card" href={caseUrl(d.slug, lang)} data-servicio={d.servicio}>
  <div class="card__media">
    <Image src={d.portada} alt="" widths={[480, 720, 960]} sizes="(min-width: 768px) 46vw, 92vw" format="webp" loading={eager ? 'eager' : 'lazy'} class="card__img" />
  </div>
  <h3 class="heading-3 card__title">{d.titulo[lang]}</h3>
  <p class="label muted">{t(serviceName(d.servicio))} · {d.anio}</p>
</a>

<style>
  .card { display: block; color: var(--text); text-decoration: none; }
  .card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--panel);
  }
  .card__img { width: 100%; height: 100%; object-fit: cover; }
  .card__title { margin-top: var(--space-3); text-decoration: underline transparent; text-decoration-thickness: 1px; text-underline-offset: 4px; transition: text-decoration-color 150ms; }
  .card:hover .card__title { text-decoration-color: currentColor; }
  .card .label { margin-top: var(--space-1); }
</style>
