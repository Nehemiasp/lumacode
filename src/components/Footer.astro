---
import Logo from './Logo.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';
import { route, homeAnchor, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  alternates: Record<Lang, string>;
}
const { lang, alternates } = Astro.props;
const { t } = useT(lang);
const year = new Date().getFullYear();

const links = [
  { label: t('nav.services'), href: route('services', lang) },
  { label: t('nav.work'), href: route('work', lang) },
  { label: t('nav.process'), href: homeAnchor('proceso', lang) },
  { label: t('nav.studio'), href: homeAnchor('estudio', lang) },
  { label: t('nav.cta'), href: route('contact', lang) },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <a href={route('home', lang)} aria-label={t('ui.home')} class="site-footer__logo"><Logo symbol height={24} /></a>

    <nav class="site-footer__nav" aria-label={t('nav.main')}>
      <ul>
        {links.map((l) => (
          <li><a class="label" href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__tools">
      <LangSwitch lang={lang} alternates={alternates} />
      <ThemeToggle lang={lang} />
    </div>

    <p class="caption graphite site-footer__copy">{t('footer.copy', { año: year, year })}. {t('footer.tagline')}</p>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--line); background: var(--paper); margin-top: var(--section-gap); }
  .site-footer__inner {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-5);
    align-items: center;
  }
  .site-footer__logo { display: inline-flex; width: fit-content; }
  .site-footer__nav ul { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); }
  .site-footer__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink);
    text-decoration: none;
  }
  .site-footer__nav a:hover { color: var(--luma-text); text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .site-footer__tools { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }
  .site-footer__copy { max-width: none; }
  @media (min-width: 900px) {
    .site-footer__inner { grid-template-columns: auto 1fr auto; column-gap: var(--space-6); }
    .site-footer__nav { justify-self: start; }
    .site-footer__copy { grid-column: 1 / -1; text-align: right; }
  }
</style>
