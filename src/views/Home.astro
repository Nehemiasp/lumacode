---
import Base from '../layouts/Base.astro';
import Screen from '../components/Screen.astro';
import WorkGrid from '../components/WorkGrid.astro';
import ServiceRow from '../components/ServiceRow.astro';
import Differentiator from '../components/Differentiator.astro';
import ProcessStep from '../components/ProcessStep.astro';
import ContactBlock from '../components/ContactBlock.astro';
import { getPublishedProjects } from '../lib/projects';
import { route, useT, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, parts } = useT(lang);

const projects = (await getPublishedProjects()).slice(0, 4);
const services = ['identity', 'comms', 'web', 'ui'] as const;
const steps = [1, 2, 3, 4] as const;
---

<Base
  lang={lang}
  title={t('meta.home.title')}
  description={t('meta.home.description')}
  alternates={{ es: route('home', 'es'), en: route('home', 'en') }}
  current="home"
  organization
>
  <section class="hero" aria-labelledby="hero-titulo">
    <div class="container hero__inner">
      <div class="hero__screen">
        <Screen animate />
      </div>
      <div class="hero__text">
        <h1 class="display-xl" id="hero-titulo">
          {t('hero.title.1')}<br />
          <span class="accent">{t('hero.title.2')}</span>
        </h1>
        <p class="body-l muted">{t('hero.lead')}</p>
        <div class="hero__actions">
          <a class="btn" href={route('contact', lang)}>{t('hero.cta')}</a>
          <a class="link" href="#trabajo">{t('hero.secondary')}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--line" id="trabajo" aria-labelledby="trabajo-titulo">
    <div class="container">
      <div class="section-head">
        <h2 class="heading-1" id="trabajo-titulo">{t('work.title')}</h2>
        {projects.length > 0 && <a class="link" href={route('work', lang)}>{t('work.all')}</a>}
      </div>
      {projects.length > 0 ? <WorkGrid projects={projects} lang={lang} /> : <p class="body-l muted empty">{t('work.empty')}</p>}
    </div>
  </section>

  <section class="section section--panel" id="servicios" aria-labelledby="servicios-titulo">
    <div class="container grid">
      <div class="services__intro">
        <h2 class="heading-1" id="servicios-titulo">{t('services.title')}</h2>
        <p class="body-l muted">{t('services.lead')}</p>
        <a class="link" href={route('services', lang)}>{t('services.more')}</a>
      </div>
      <div class="services__list">
        {services.map((s) => (
          <ServiceRow name={t(`services.${s}.name`)} description={t(`services.${s}.desc`)} includes={t(`services.${s}.includes`)} />
        ))}
      </div>
    </div>
  </section>

  <Differentiator lang={lang} />

  <section class="section section--line" id="proceso" aria-labelledby="proceso-titulo">
    <div class="container">
      <h2 class="heading-1" id="proceso-titulo">{t('process.title')}</h2>
      <ol class="process">
        {steps.map((n) => {
          const [title, description] = parts(`process.${n}`);
          return <ProcessStep title={title} description={description} last={n === 4} />;
        })}
      </ol>
    </div>
  </section>

  <section class="section section--line" id="estudio" aria-labelledby="estudio-titulo">
    <div class="container grid">
      <h2 class="heading-1 studio__title" id="estudio-titulo">{t('studio.title')}</h2>
      <div class="studio__text">
        <p class="body-l">{t('studio.p1')}</p>
        <p class="body-l muted">{t('studio.p2')}</p>
      </div>
    </div>
  </section>

  <ContactBlock lang={lang} />
</Base>

<style>
  .hero { padding-block: var(--space-6) calc(var(--section-gap) / 2); }
  .hero__inner { display: flex; flex-direction: column; gap: var(--space-5); }
  .hero__screen { width: 200px; }
  .hero__text { display: grid; gap: var(--space-4); justify-items: start; }
  .hero__text .body-l { max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-5); margin-top: var(--space-2); }

  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-3); margin-bottom: var(--space-5); }
  .empty { max-width: 52ch; }

  .services__intro { grid-column: 1 / -1; display: grid; gap: var(--space-3); align-content: start; justify-items: start; }
  .services__list { grid-column: 1 / -1; }

  .process {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-5) var(--space-4);
    margin-top: var(--space-5);
  }

  .studio__title { grid-column: 1 / -1; }
  .studio__text { grid-column: 1 / -1; display: grid; gap: var(--space-4); }

  @media (min-width: 768px) {
    .hero { padding-block: var(--space-7) calc(var(--section-gap) / 2); }
    .hero__inner { flex-direction: row; align-items: center; justify-content: space-between; gap: var(--space-6); }
    .hero__text { flex: 0 1 60%; }
    .hero__screen { order: 2; flex: 0 1 40%; width: auto; display: flex; justify-content: flex-end; }
    .services__intro { grid-column: 1 / span 4; }
    .services__list { grid-column: 5 / -1; }
    .services__list :global(.row:first-child) { border-top: 0; padding-top: 0; }
    .studio__title { grid-column: 1 / span 5; }
    .studio__text { grid-column: 7 / -1; }
  }
</style>
