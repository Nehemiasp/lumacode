---
import Base from '../layouts/Base.astro';
import ServiceDetail from '../components/ServiceDetail.astro';
import PackageCard from '../components/PackageCard.astro';
import FAQ from '../components/FAQ.astro';
import { config, type PackageId } from '../config';
import { splitLast } from '../lib/text';
import { route, useT, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { t, parts } = useT(lang);

const services = ['identity', 'comms', 'web', 'ui'] as const;
const packages = [
  { id: 'marca', key: 'pkg.brand', featured: false },
  { id: 'presencia', key: 'pkg.presence', featured: true },
  { id: 'sitio', key: 'pkg.site', featured: false },
  { id: 'producto', key: 'pkg.product', featured: false },
] as const satisfies readonly { id: PackageId; key: 'pkg.brand' | 'pkg.presence' | 'pkg.site' | 'pkg.product'; featured: boolean }[];
const faqs = ([1, 2, 3, 4] as const).map((n) => ({ q: t(`faq.${n}.q`), a: t(`faq.${n}.a`) }));
const [titleHead, titleAccent] = splitLast(t('svc.title.2'));
---

<Base
  lang={lang}
  title={t('meta.services.title')}
  description={t('meta.services.description')}
  alternates={{ es: route('services', 'es'), en: route('services', 'en') }}
  current="services"
>
  <div class="container page-head head">
    <h1 class="display-xl">
      {t('svc.title.1')}<br />
      {titleHead}<span class="accent">{titleAccent}</span>
    </h1>
    <p class="body-l head__lead">{t('svc.lead')}</p>
  </div>

  <section class="section" aria-label={t('nav.services')}>
    <div class="container">
      {services.map((s) => (
        <ServiceDetail
          name={t(`services.${s}.name`)}
          description={t(`svc.${s}.long`)}
          deliverablesTitle={t('svc.deliverables')}
          deliverables={parts(`svc.${s}.list`)}
          ideal={t(`svc.${s}.ideal`)}
        />
      ))}
    </div>
  </section>

  <section class="section--stone" id="paquetes" aria-labelledby="paquetes-titulo">
    <div class="container">
      <div class="pkg-head">
        <h2 class="heading-1" id="paquetes-titulo">{t('pkg.title')}</h2>
        <p class="body graphite">{t('pkg.lead')}</p>
      </div>
      <div class="packages">
        {packages.map((p) => {
          const [name, forWho, includes] = parts(p.key);
          const price = config.precios[p.id].trim() || t('pkg.quote');
          return <PackageCard name={name} forWho={forWho} includes={includes} price={price} featured={p.featured} />;
        })}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-titulo">
    <div class="container grid">
      <h2 class="heading-1 col-title" id="faq-titulo">{t('faq.title')}</h2>
      <div class="col-body"><FAQ items={faqs} /></div>
    </div>
  </section>

  <section class="section-ink band" aria-labelledby="cierre-titulo">
    <div class="container close">
      <h2 class="heading-1" id="cierre-titulo">{t('svc.close.title')}</h2>
      <a class="btn" href={route('contact', lang)}>{t('svc.close.cta')}</a>
    </div>
  </section>
</Base>

<style>
  .head { display: grid; gap: var(--space-4); align-items: end; }
  .head__lead { max-width: 36ch; }
  .section--stone { padding-block: var(--section-gap); }
  .pkg-head { display: grid; gap: var(--space-2); margin-bottom: var(--space-5); align-items: end; }
  .packages { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; }
  .close { display: grid; gap: var(--space-4); justify-items: start; align-items: center; }
  @media (min-width: 768px) {
    .head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--space-4); }
    .head h1 { grid-column: 1 / span 9; }
    .head__lead { grid-column: 10 / -1; padding-bottom: var(--space-3); }
    .pkg-head { grid-template-columns: 1fr auto; }
    .pkg-head p { max-width: 36ch; }
    .close { grid-template-columns: 1fr auto; }
  }
</style>
