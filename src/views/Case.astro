---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getPublishedProjects, type Project } from '../lib/projects';
import { serviceName } from '../lib/services';
import { caseUrl, route, useT, type Lang } from '../i18n';

interface Props { lang: Lang; project: Project }
const { lang, project } = Astro.props;
const { t } = useT(lang);
const d = project.data;

const published = await getPublishedProjects();
const index = published.findIndex((p) => p.data.slug === d.slug);
const next = published.length > 1 ? published[(index + 1) % published.length] : null;

const ogImage = await getImage({ src: d.portada, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
---

<Base
  lang={lang}
  title={`${d.titulo[lang]} · Lumacode Studio`}
  description={d.resumen[lang]}
  alternates={{ es: caseUrl(d.slug, 'es'), en: caseUrl(d.slug, 'en') }}
  current="case"
  ogImage={ogImage.src}
>
  <article>
    <header class="container case-head">
      <a class="link label" href={route('work', lang)}>{t('case.back')}</a>
      <p class="label graphite">{t(serviceName(d.servicio))} · {d.anio}</p>
      <h1 class="display-l">{d.titulo[lang]}</h1>
      <p class="body-l graphite">{d.resumen[lang]}</p>
    </header>

    <div class="container">
      <Image class="case-cover" src={d.portada} alt={d.titulo[lang]} widths={[720, 1080, 1440, 1920]} sizes="(min-width: 1360px) 1280px, 92vw" format="webp" loading="eager" fetchpriority="high" />
    </div>

    <div class="container">
      <dl class="facts">
        <div><dt class="label graphite">{t('case.client')}</dt><dd class="body">{d.cliente[lang]}</dd></div>
        <div><dt class="label graphite">{t('case.service')}</dt><dd class="body">{t(serviceName(d.servicio))}</dd></div>
        <div><dt class="label graphite">{t('case.duration')}</dt><dd class="body">{d.duracion[lang]}</dd></div>
        <div>
          <dt class="label graphite">{t('case.deliverables')}</dt>
          <dd class="body">{d.entregables[lang].map((item) => <span class="facts__item">{item}</span>)}</dd>
        </div>
      </dl>
    </div>

    <section class="section" aria-labelledby="reto-titulo">
      <div class="container grid">
        <h2 class="heading-1 col-title" id="reto-titulo">{t('case.challenge')}</h2>
        <div class="col-body challenge">
          <p class="body-l">{d.reto[lang]}</p>
          {d.retoImagen && (
            <figure class="media">
              <Image src={d.retoImagen.src} alt={d.retoImagen.alt[lang]} widths={[640, 960, 1280]} sizes="(min-width: 768px) 66vw, 92vw" format="webp" loading="lazy" />
              {d.retoImagen.pie && <figcaption class="caption graphite">{d.retoImagen.pie[lang]}</figcaption>}
            </figure>
          )}
        </div>
      </div>
    </section>

    {d.decisiones.length > 0 && (
      <section class="section--stone" aria-labelledby="decisiones-titulo">
        <div class="container">
          <h2 class="heading-1" id="decisiones-titulo">{t('case.decisions')}</h2>
          <ol class="decisions">
            {d.decisiones.map((decision, i) => (
              <li class:list={['decision', { 'decision--last': i === d.decisiones.length - 1 }]}>
                <div class="decision__text">
                  <p class="label graphite">{t('case.decision', { n: i + 1 })}</p>
                  <h3 class="heading-2">{decision.titulo[lang]}</h3>
                  <p class="body">{decision.porque[lang]}</p>
                </div>
                {decision.imagen && (
                  <figure class="decision__media media">
                    <Image src={decision.imagen.src} alt={decision.imagen.alt[lang]} widths={[640, 960, 1280]} sizes="(min-width: 768px) 50vw, 92vw" format="webp" loading="lazy" />
                    {decision.imagen.pie && <figcaption class="caption graphite">{decision.imagen.pie[lang]}</figcaption>}
                  </figure>
                )}
              </li>
            ))}
          </ol>
        </div>
      </section>
    )}

    {d.imagenes.length > 0 && (
      <section class="section" aria-label={d.titulo[lang]}>
        <div class="container gallery">
          {d.imagenes.map((img) => (
            <figure class="media">
              <Image src={img.src} alt={img.alt[lang]} widths={[720, 1080, 1440]} sizes="92vw" format="webp" loading="lazy" />
              {img.pie && <figcaption class="caption graphite">{img.pie[lang]}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {d.resultados && d.resultados.length > 0 && (
      <section class="section" aria-labelledby="resultado-titulo">
        <div class="container">
          <h2 class="heading-1" id="resultado-titulo">{t('case.result')}</h2>
          <ul class="results">
            {d.resultados.map((r, i) => (
              <li>
                <p class:list={['result__figure', { accent: i === 0 }]}>{r.dato}</p>
                <p class="body graphite">{r.descripcion[lang]}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <section class="section-ink band" aria-label={t('case.next')}>
      <div class="container end">
        {next && (
          <div class="end__next">
            <p class="label graphite">{t('case.next')}</p>
            <a class="heading-1 link" href={caseUrl(next.data.slug, lang)}>{next.data.titulo[lang]}</a>
          </div>
        )}
        <a class="btn" href={route('contact', lang)}>{t('case.cta')}</a>
      </div>
    </section>
  </article>
</Base>

<style>
  .case-head { display: grid; gap: var(--space-3); justify-items: start; padding-block: var(--space-5) var(--space-5); }
  .case-head .body-l { max-width: 52ch; }
  .case-cover { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-0); background: var(--stone); }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    margin: var(--space-5) 0 0;
    padding-block: var(--space-4);
    border-block: 1px solid var(--line);
  }
  .facts dd { margin: 0; }
  .facts__item { display: block; }
  @media (min-width: 768px) {
    .facts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .challenge { display: grid; gap: var(--space-4); }
  .media { display: grid; gap: var(--space-2); }
  .media :global(img) { width: 100%; height: auto; border-radius: var(--radius-0); background: var(--stone); }

  .section--stone { padding-block: var(--section-gap); }
  .decisions { display: grid; gap: var(--space-5); margin-top: var(--space-5); }
  .decision { display: grid; gap: var(--space-4); align-items: center; padding-top: var(--space-4); border-top: 2px solid var(--ink); }
  .decision--last { border-top-color: var(--luma); }
  .decision__text { display: grid; gap: var(--space-2); align-content: start; }
  .decision__media :global(img) { background: var(--paper); }
  @media (min-width: 768px) {
    .decision { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
    /* Alterna texto e imagen */
    .decision:nth-child(even) .decision__text { order: 2; }
  }

  .gallery { display: grid; gap: var(--space-5); }

  .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-5) var(--space-4); margin-top: var(--space-5); }
  .results li { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-3); border-top: 1px solid var(--line); }
  .result__figure { font-family: var(--font-display); font-size: 64px; line-height: 1; font-weight: 700; letter-spacing: -0.03em; }

  .end { display: grid; gap: var(--space-5); align-items: end; }
  .end__next { display: grid; gap: var(--space-2); justify-items: start; }
  @media (min-width: 768px) {
    .end { grid-template-columns: 1fr auto; }
  }
</style>
