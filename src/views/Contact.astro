---
import Base from '../layouts/Base.astro';
import { route, useT, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useT(lang);
---
<Base lang={lang} title={t('meta.contact.title')} description={t('meta.contact.description')} alternates={{ es: route('contact', 'es'), en: route('contact', 'en') }}>
  <h1>{t('meta.contact.title')}</h1>
</Base>
